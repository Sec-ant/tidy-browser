{
  "name": "@sec-ant/browser-cookies",
  "version": "0.1.0",
  "description": "Lightweight Node.js library for parsing browser cookies using Rust",
  "main": "index.js",
  "types": "index.d.ts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Sec-ant/tidy-browser.git"
  },
  "license": "LGPL-3.0-or-later",
  "keywords": [
    "cookies",
    "browser",
    "chrome",
    "firefox", 
    "safari",
    "rust",
    "napi-rs",
    "parser"
  ],
  "files": [
    "index.d.ts",
    "index.js",
    "example.js",
    "README.md"
  ],
  "napi": {
    "binaryName": "browser-cookies",
    "targets": [
      "x86_64-unknown-linux-gnu",
      "x86_64-apple-darwin", 
      "x86_64-pc-windows-msvc",
      "aarch64-unknown-linux-gnu",
      "aarch64-apple-darwin"
    ]
  },
  "engines": {
    "node": ">= 16"
  },
  "scripts": {
    "artifacts": "napi artifacts",
    "build": "napi build --platform --release",
    "build:debug": "napi build --platform",
    "test": "node --test __test__/*.js",
    "test:with-mock": "node create_test_db.js && TEST_CHROME_PATH=/tmp/test_chrome node test_real.js",
    "prepublishOnly": "napi prepublish -t npm",
    "clean": "rimraf *.node artifacts target"
  },
  "devDependencies": {
    "@napi-rs/cli": "^3.1.1",
    "@types/node": "^22.0.0"
  }
}